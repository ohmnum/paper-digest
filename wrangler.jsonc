// Cloudflare Workers 설정. 이 파일이 있으면 배포 때 설정을 추측하지 않는다 (없으면 Hugo 로 잘못 추측해서 실패했음).
{
  "name": "paper-digest",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // 데이터베이스: 처음 배포할 때 Cloudflare 가 "paper-digest" 라는 D1 을 자동으로 만들어 연결한다
  "d1_databases": [{ "binding": "DB", "database_name": "paper-digest" }],
  // 대시보드에서 넣은 일반 값(GEMINI_MODEL 등)을 배포 때 지우지 않는다. 비밀값(ADMIN_KEY 등)은 원래 유지된다
  "keep_vars": true,
  "observability": { "enabled": true }
}
